APP_NAME="LS Tech TopUp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ls_tech_topup_game
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

# ==========================================
# ABA PayWay / KHQR Payment Gateway Config
# ==========================================
ABA_PAYWAY_SANDBOX=true
ABA_PAYWAY_MERCHANT_ID=ec438902
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_PAYWAY_CHECK_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2
ABA_PAYWAY_EXPIRY_MINUTES=15

# ==========================================
# Authorized Top-Up Provider Config
# ==========================================
# Options: mock_provider, authorized_api
TOPUP_ACTIVE_PROVIDER=mock_provider
TOPUP_MOCK_AUTO_SUCCESS=true

# Authorized Partner API Credentials (when using live provider)
TOPUP_PROVIDER_API_URL=https://api.partner-topup.com/v1
TOPUP_PROVIDER_MERCHANT_ID=
TOPUP_PROVIDER_API_KEY=
TOPUP_PROVIDER_SECRET=

VITE_APP_NAME="${APP_NAME}"
